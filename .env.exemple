# Copie este arquivo para .env. Nunca versione o .env.
# Configuração da aplicação e dos serviços locais.
NODE_ENV=development
PORT=3100
TZ=America/Sao_Paulo

# Banco central e banco exclusivo do tenant piloto. Preencher antes de conectar.
CONTROL_DATABASE_URL=
TENANT_DATABASE_URL=

# Confirmar agrupamento das 14 filiais em uma mesma empresa antes da importação.
TENANT_KEY=aeropostale
PRODUCT_NAME=Join Network
TENANT_DISPLAY_NAME=Aeropostale
PILOT_CONFIG_PATH=config/piloto.json

# Millennium: endereço atual documentado; transporte seguro ainda precisa ser validado.
MILLENNIUM_BASE_URL=http://app.aeropostale.com.br:6017/api
# Somente o token Basic, sem o prefixo "Basic ".
MILLENNIUM_BASIC_TOKEN=
# true habilita o worker periódico; false impede seu início.
SYNC_ENABLED=false
SYNC_INTERVAL_SECONDS=360
SYNC_INITIAL_DATE=2026-01-01
SYNC_INITIAL_END_DATE=2026-09-09
SYNC_FAILURE_THRESHOLD=3

# Talk: somente o token, sem o prefixo "Bearer ".
TALK_SEND_URL=https://apitalk.joinnetwork.com.br/api/messages/send
TALK_TOKEN=
TALK_ADMIN_NUMBER=
TALK_USER_ID=
TALK_QUEUE_ID=
TALK_ALERTS_ENABLED=false

# PostgreSQL local — gerar senhas distintas no .env, sem versioná-las.
POSTGRES_PORT=55432
POSTGRES_ADMIN_PASSWORD=
CONTROL_DB_PASSWORD=
TENANT_DB_PASSWORD=
# CONTROL_DATABASE_URL=postgresql://varejo_control:SENHA@127.0.0.1:55432/varejo_control
# TENANT_DATABASE_URL=postgresql://varejo_aeropostale:SENHA@127.0.0.1:55432/varejo_aeropostale

# Login Admin inicial: senha >=16 caracteres. Não versionar a senha.
ADMIN_EMAIL=admin@aeropostale.local
ADMIN_PASSWORD=
API_HOST=127.0.0.1
