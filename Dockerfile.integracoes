FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --chown=node:node backend/src ./backend/src
COPY --chown=node:node config ./config
COPY --chown=node:node database/migrations ./database/migrations
COPY --chown=node:node frontend/integracoes ./frontend/integracoes
COPY --chown=node:node scripts/integracoes-api.mjs scripts/integracoes-worker.mjs scripts/integracoes-operador.mjs scripts/autorizar-operador.mjs scripts/migrar.mjs ./scripts/
USER node
CMD ["node", "scripts/integracoes-api.mjs"]
