              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "ordenar",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "valor",
                "pecas",
                "ticket"
              ],
              "default": "valor"
            }
          }
        ]
      }
