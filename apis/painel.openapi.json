                    "maxLength": 80
                  },
                  "permissoes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "indicadores:ler",
                        "vendas:ler",
                        "ranking:ler",
                        "conferencia:ler",
                        "clientes:ler",
                        "imagens:ler"
                      ]
                    }
                  },
